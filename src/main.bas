3331 IF (K$="W" OR K$="w") AND PX%<TP% THEN PX%=PX%+1: GOTO 3300
3332 IF (K$="Z" OR K$="z") AND PX%>1 THEN PX%=PX%-1: GOTO 3300
3333 REM --- SELECT DIGIT 1-8 ---
3334 SE%=VAL(K$)
3335 IF SE%<1 OR SE%>TC% THEN SZ$="INVALID SELECTION": GOTO 3300
3336 CU%=TR%(SE%): REM INDEX IN RC$
3337 PS%=SC%: MD%=1: GOSUB 7000: GOTO 5100

3700 REM *** MESSAGE SCREEN ***
3701 TT$="INFORMATION": GOSUB 1000
3702 LN$="": GOSUB 1018
3703 LN$="  "+MG$: GOSUB 1018
