7100 REM *** READ LAST+FIRST NAME FROM TR$(IX%) ***
7101 REM READS TR$(IX%) INDIRECTLY FROM RC$ ---
7102 RI%=TR%(IX%): REM INDEX IN RC$
7103 RS$=RC$(RI%)
7104 GOSUB 7600
7105 IF PP%=0 THEN NA$=RS$: VN$="": RETURN
7106 NA$=LEFT$(RS$,PP%-1)
7107 RS$=MID$(RS$,PP%+1)
7108 GOSUB 7600
7109 IF PP%=0 THEN VN$=RS$: RETURN
7110 VN$=LEFT$(RS$,PP%-1)
7111 RETURN

7200 REM *** REMOVE PIPE CHARS FROM FIELD FI% ***
7201 TP$="": TS$=F$(FI%): LF%=LEN(TS$): TI%=1
7202 IF TI%>LF% THEN GOTO 7206
7203 TC$=MID$(TS$,TI%,1)
7204 IF TC$<>"|" AND TC$<>CHR$(13) AND TC$<>CHR$(10) THEN TP$=TP$+TC$
7205 TI%=TI%+1: GOTO 7202
7206 F$(FI%)=TP$
7207 RETURN

7300 REM *** READ LAST NAME FROM RC$(SI%) -> XN$ ***
7301 RS$=RC$(SI%)
7302 GOSUB 7600
7303 IF PP%=0 THEN XN$=RS$: RETURN
7304 XN$=LEFT$(RS$,PP%-1)
7305 RETURN

7400 REM *** COPY PREP: LOAD FIELDS FROM CU% ***
7401 GOSUB 7500: REM DECODE
7402 F$(1)=NA$: F$(2)=VN$: F$(3)=EM$: F$(4)=ST$: F$(5)=OT$: F$(6)=TF$
7403 RETURN

7500 REM *** DECODE ALL FIELDS FROM RC$(LI%) ***
7501 REM ERGEBNIS: NA$,VN$,EM$,ST$,OT$,TF$ ***
7502 IF LI%=0 THEN LI%=CU%: REM FALLBACK TO CURRENT
7503 RS$=RC$(LI%)
7504 REM --- LAST NAME ---
7505 GOSUB 7600
7506 IF PP%=0 THEN NA$=RS$: VN$="": EM$="": ST$="": OT$="": TF$="": RETURN
7507 NA$=LEFT$(RS$,PP%-1): RS$=MID$(RS$,PP%+1)
7508 REM --- FIRST NAME ---
7509 GOSUB 7600
7510 IF PP%=0 THEN VN$=RS$: EM$="": ST$="": OT$="": TF$="": RETURN
7511 VN$=LEFT$(RS$,PP%-1): RS$=MID$(RS$,PP%+1)
7512 REM --- EMAIL ---
7513 GOSUB 7600
7514 IF PP%=0 THEN EM$=RS$: ST$="": OT$="": TF$="": RETURN
7515 EM$=LEFT$(RS$,PP%-1): RS$=MID$(RS$,PP%+1)
7516 REM --- STREET ---
7517 GOSUB 7600
7518 IF PP%=0 THEN ST$=RS$: OT$="": TF$="": RETURN
7519 ST$=LEFT$(RS$,PP%-1): RS$=MID$(RS$,PP%+1)
7520 REM --- CITY ---
7521 GOSUB 7600
7522 IF PP%=0 THEN OT$=RS$: TF$="": RETURN
7523 OT$=LEFT$(RS$,PP%-1): RS$=MID$(RS$,PP%+1)
7524 REM --- PHONE ---
7525 TF$=RS$
7526 RETURN

7600 REM *** FIND POSITION OF "|" IN RS$ -> PP% ***
7601 PP%=0
7602 LP%=LEN(RS$)
