10 REM *** ADDRESS MANAGER - C64 BASIC V2 ***
11 REM *** VERSION 1.0 - 2026 ***
12 REM *** DATA FILE: ADDRESSES.DAT ***
20 GOTO 100

100 REM *** INIT & CONSTANTS ***
110 ONERR GOTO 9000
115 REM --- FRAME CHARACTERS ---
116 HT$=CHR$(195): REM HORIZONTAL LINE (SHIFT+C)
117 VT$=CHR$(194): REM VERTICAL LINE (SHIFT+B)
118 TL$=CHR$(213): REM TOP-LEFT CORNER (SHIFT+U)
119 TR$=CHR$(201): REM TOP-RIGHT CORNER (SHIFT+I)
120 REM --- FIELD LENGTHS ---
121 NL%=30 : REM LAST NAME MAX
122 VL%=30 : REM FIRST NAME MAX
123 EL%=40 : REM EMAIL MAX
124 SL%=40 : REM STREET MAX
125 OL%=30 : REM CITY MAX
126 TL%=20 : REM PHONE MAX
127 PG%=8  : REM PAGE MAX ENTRIES
128 MX%=200: REM MAX RECORDS
129 DA$="ADDRESSES.DAT": REM FILENAME
130 REM --- ARRAYS ---
131 DIM RC$(200): REM ALL RECORDS (LOADED)
132 DIM TR%(20) : REM RESULTS LIST (INDICES IN RC$)
133 DIM F$(6)   : REM FORM FIELDS (1-6)
134 RC%=0  : REM NUMBER OF RECORDS
135 TC%=0  : REM NUMBER OF RESULTS
136 SC%=1  : REM SCREEN STATE (1=MAIN)
137 PS%=1  : REM PREVIOUS STATE (FOR ERROR RETURN)
138 CU%=0  : REM CURRENTLY SELECTED (INDEX IN RC$)
139 PX%=1  : REM CURRENT PAGE (PAGINATION)
140 REM --- PRECOMPUTE FRAME STRINGS ---
141 BL$=CHR$(202): REM BOTTOM-LEFT CORNER (SHIFT+J)
142 BR$=CHR$(203): REM BOTTOM-RIGHT CORNER (SHIFT+K)
143 LT$=CHR$(171): REM LEFT T-PIECE (COMMODORE+Q)
144 RT$=CHR$(179): REM RIGHT T-PIECE (COMMODORE+W)
145 HS$="": HI%=1
146 IF HI%>38 THEN GOTO 148
147 HS$=HS$+HT$: HI%=HI%+1: GOTO 146
148 REM HS$ = 38 HORIZONTAL CHARS
149 SP$=HS$
150 REM --- LOAD FILE ---
151 GOSUB 2000: REM READ ALL RECORDS
155 SC%=1
160 GOTO 3000

1000 REM *** DRAW TOP BORDER + TITLE BAR ***
1001 PRINT CHR$(147);
1002 PRINT TL$+HS$+TR$;
1003 TX$=TT$: GOSUB 1050
1004 PRINT LT$+HS$+RT$;
1005 RETURN

1006 REM *** DRAW SEPARATOR LINE ***
1007 PRINT LT$+HS$+RT$;
1008 RETURN

1009 REM *** DRAW ACTION BAR (AC$=ACTION TEXT) ***
1010 PRINT LT$+HS$+RT$;
1011 TX$=AC$: GOSUB 1050
1012 RETURN

1013 REM *** DRAW STATUS LINE (SZ$=STATUS TEXT) ***
1014 PRINT LT$+HS$+RT$;
1015 TX$=SZ$: GOSUB 1050
1016 PRINT BL$+HS$+BR$;
1017 RETURN

1018 REM *** PRINT FRAMED CONTENT LINE (LN$=TEXT) ***
1019 TX$=LN$: GOSUB 1050
1020 RETURN

1022 REM *** READ SINGLE KEY ***
1023 GET K$
1024 IF K$="" THEN GOTO 1023
1025 RETURN

1030 REM *** INPUT FIELD WITH MAX LENGTH ***
1031 REM IN$=PREFILL, EM%=MAX, RESULT IN IN$ ***
1032 PRINT IN$;
1033 LN$=IN$: LI%=LEN(LN$)
1034 GOSUB 1022: REM KEY
1035 IF K$=CHR$(13) THEN IN$=LN$: RETURN
1036 IF K$<>CHR$(20) THEN GOTO 1039
1037 IF LI%>0 THEN LI%=LI%-1: LN$=LEFT$(LN$,LI%): PRINT CHR$(29);CHR$(32);CHR$(29);
1038 GOTO 1034
1039 IF LI%>=EM% THEN GOTO 1034
1040 IF K$>=" " AND K$<CHR$(127) THEN LN$=LN$+K$: LI%=LI%+1: PRINT K$;
1041 GOTO 1034

1050 REM *** SAFE FRAMED TEXT OUTPUT (TX$) ***
1051 TY$=""
1052 CP%=1
1053 IF CP%>36 THEN GOTO 1058
1054 IF CP%>LEN(TX$) THEN GOTO 1058
1055 TY$=TY$+MID$(TX$,CP%,1)
1056 CP%=CP%+1
1057 GOTO 1053
1058 PRINT VT$+" "+TY$;
1059 CP%=LEN(TY$)+1
1060 IF CP%>36 THEN GOTO 1063
1061 PRINT " ";
1062 CP%=CP%+1: GOTO 1060
1063 PRINT " "+VT$;
1064 RETURN

2000 REM *** READ ALL RECORDS FROM DISK ***
2001 RC%=0
2002 OPEN 1,8,2,"0:"+DA$+",S,R"
2003 IF ST<>0 THEN CLOSE 1: RETURN: REM FILE NOT FOUND = NO ERROR
2004 INPUT#1,RC$(RC%+1)
2005 IF ST<>0 AND ST<>64 THEN GOTO 2009: REM OTHER I/O STATUS
2006 IF RC$(RC%+1)<>"" THEN RC%=RC%+1
2007 IF ST=64 THEN GOTO 2009: REM END OF FILE
2008 IF RC%<MX% THEN GOTO 2004
2009 CLOSE 1
2010 RETURN

2100 REM *** WRITE ALL RECORDS TO DISK ***
2101 REM DELETE EXISTING FILE + REWRITE ***
2102 OPEN 1,8,15: REM COMMAND CHANNEL
2103 PRINT#1,"S0:"+DA$: REM DELETE FILE (SCRATCH)
2104 CLOSE 1
2105 OPEN 1,8,2,"0:"+DA$+",S,W"
2106 WI%=1
2107 IF WI%>RC% THEN GOTO 2109
2108 PRINT#1,RC$(WI%): WI%=WI%+1: GOTO 2107
2109 CLOSE 1
2110 IF ST<>0 THEN GOTO 9000
2111 RETURN

