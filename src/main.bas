10 REM *** ADDRESS MANAGER - C64 BASIC V2 ***
11 REM *** VERSION 1.0 - 2026 ***
12 REM *** DATA FILE: ADDRESSES.DAT ***
20 GOTO 100

100 REM *** INIT & CONSTANTS ***
110 ONERR GOTO 9000
120 REM --- FIELD LENGTHS ---
121 NL%=30 : REM LAST NAME MAX
122 VL%=30 : REM FIRST NAME MAX
123 EL%=40 : REM EMAIL MAX
124 SL%=40 : REM STREET MAX
125 OL%=30 : REM CITY MAX
126 TL%=20 : REM PHONE MAX
127 PG%=8  : REM PAGE MAX ENTRIES
128 MX%=200: REM MAX RECORDS
129 DA$="ADDRESSES.DAT": REM FILENAME
130 REM --- ARRAYS ---
131 DIM RC$(200): REM ALL RECORDS (LOADED)
132 DIM TR%(20) : REM RESULTS LIST (INDICES IN RC$)
133 DIM F$(6)   : REM FORM FIELDS (1-6)
134 RC%=0  : REM NUMBER OF RECORDS
135 TC%=0  : REM NUMBER OF RESULTS
136 SC%=1  : REM SCREEN STATE (1=MAIN)
137 PS%=1  : REM PREVIOUS STATE (FOR ERROR RETURN)
138 CU%=0  : REM CURRENTLY SELECTED (INDEX IN RC$)
139 PX%=1  : REM CURRENT PAGE (PAGINATION)
140 REM --- LOAD FILE ---
141 GOSUB 2000: REM READ ALL RECORDS
150 SC%=1
160 GOTO 3000

1000 REM *** SCREEN CLEAR AND HEADER ***
1001 PRINT CHR$(147)
1002 PRINT "========================================"
1003 PRINT "        C64 ADDRESS MANAGER V1.0"
1004 PRINT "========================================"
1005 RETURN

1010 REM *** SEPARATOR LINE ***
1011 PRINT "----------------------------------------"
1012 RETURN

1020 REM *** READ SINGLE KEY ***
1021 GET K$
1022 IF K$="" THEN GOTO 1021
1023 RETURN

1030 REM *** INPUT FIELD WITH MAX LENGTH ***
1031 REM IN$=PREFILL, EM%=MAX, RESULT IN IN$ ***
1032 PRINT IN$;
1033 LN$=IN$: LI%=LEN(LN$)
1034 GOSUB 1020: REM KEY
1035 IF K$=CHR$(13) THEN IN$=LN$: RETURN
1036 IF K$<>CHR$(20) THEN GOTO 1039
1037 IF LI%>0 THEN LI%=LI%-1: LN$=LEFT$(LN$,LI%): PRINT CHR$(29);CHR$(32);CHR$(29);
1038 GOTO 1034
1039 IF LI%>=EM% THEN GOTO 1034
1040 IF K$>=" " AND K$<CHR$(127) THEN LN$=LN$+K$: LI%=LI%+1: PRINT K$;
1041 GOTO 1034

2000 REM *** READ ALL RECORDS FROM DISK ***
2001 RC%=0
2002 OPEN 1,8,2,"0:"+DA$+",S,R"
2003 IF ST<>0 THEN CLOSE 1: RETURN: REM FILE NOT FOUND = NO ERROR
2004 INPUT#1,RC$(RC%+1)
2005 IF ST<>0 AND ST<>64 THEN GOTO 2009: REM OTHER I/O STATUS
2006 IF RC$(RC%+1)<>"" THEN RC%=RC%+1
2007 IF ST=64 THEN GOTO 2009: REM END OF FILE
2008 IF RC%<MX% THEN GOTO 2004
2009 CLOSE 1
2010 RETURN

2100 REM *** WRITE ALL RECORDS TO DISK ***
2101 REM DELETE EXISTING FILE + REWRITE ***
2102 OPEN 1,8,15: REM COMMAND CHANNEL
2103 PRINT#1,"S0:"+DA$: REM DELETE FILE (SCRATCH)
2104 CLOSE 1
2105 OPEN 1,8,2,"0:"+DA$+",S,W"
2106 WI%=1
2107 IF WI%>RC% THEN GOTO 2109
2108 PRINT#1,RC$(WI%): WI%=WI%+1: GOTO 2107
2109 CLOSE 1
2110 IF ST<>0 THEN GOTO 9000
2111 RETURN

3000 REM *** STATE MACHINE DISPATCH ***
3001 IF SC%=1 THEN GOTO 3100: REM MAIN MENU
3002 IF SC%=2 THEN GOTO 3200: REM SEARCH MASK
3003 IF SC%=3 THEN GOTO 3300: REM RESULTS LIST
3004 IF SC%=4 THEN GOTO 4000: REM ENTRY FORM
3005 IF SC%=5 THEN GOTO 6000: REM FULL LIST
3006 IF SC%=6 THEN GOTO 5600: REM DELETE CONFIRMATION
3007 IF SC%=7 THEN GOTO 3700: REM MESSAGE
3008 GOTO 3100: REM FALLBACK MAIN MENU

3100 REM *** MAIN MENU ***
3101 GOSUB 1000
3102 PRINT ""
3103 PRINT "  1. MANAGE ENTRIES"
3104 PRINT ""
3105 PRINT "  2. SHOW ALL ADDRESSES"
3106 PRINT ""
3107 PRINT "  Q. QUIT"
3108 PRINT ""
3109 GOSUB 1010
3110 PRINT "  PRESS KEY: ";
3111 GOSUB 1020
3112 IF K$="1" THEN PS%=SC%: SC%=2: GOTO 3000
3113 IF K$="2" THEN PS%=SC%: SC%=5: GOTO 3000
3114 IF K$="Q" OR K$="q" THEN GOTO 3900
3115 GOTO 3110

3200 REM *** SEARCH MASK ***
3201 GOSUB 1000
3202 PRINT ""
3203 PRINT "  MANAGE ENTRIES"
3204 PRINT ""
3205 GOSUB 1010
3206 PRINT "  PRESS KEY:"
3207 PRINT "  N = NEW ENTRY"
3208 PRINT "  S = SEARCH BY LAST NAME"
3209 PRINT "  M = MAIN MENU"
3210 PRINT ""
3211 PRINT "  KEY: ";
3212 GOSUB 1020
3213 IF K$="N" OR K$="n" THEN PS%=SC%: SC%=4: MD%=0: GOSUB 7000: GOTO 3000
3214 IF K$="M" OR K$="m" THEN SC%=1: GOTO 3000
3215 IF K$="S" OR K$="s" THEN GOTO 3250
3216 GOTO 3211
3250 REM --- SEARCH INPUT ---
3251 GOSUB 1000
3252 PRINT "  SEARCH LAST NAME:"
3253 PRINT ""
3254 GOSUB 1010
3255 PRINT "  LAST NAME: ";
3256 IN$="": EM%=NL%: GOSUB 1030: PRINT ""
3257 SN$=IN$
3258 IF SN$="" THEN GOTO 3254
3259 PS%=SC%: GOSUB 5000
3260 IF TC%=0 THEN SC%=7: MG$="NO RESULTS FOR: "+SN$: MR%=2: GOTO 3000
3261 SC%=3: PX%=1: GOTO 3000

3300 REM *** RESULTS LIST ***
3301 GOSUB 1000
3302 PRINT ""
3303 PRINT "  SEARCH RESULTS FOR: "+SN$
3304 PRINT "  "+STR$(TC%)+" RESULTS FOUND"
3305 PRINT ""
3306 GOSUB 1010
3307 REM --- DISPLAY PAGE ---
3308 PF%=(PX%-1)*PG%+1: REM ERSTER EINTRAG AUF SEITE
3309 PL%=PF%+PG%-1: REM LETZTER
3310 IF PL%>TC% THEN PL%=TC%
3311 IX%=PF%
3312 IF IX%>PL% THEN GOTO 3315
3313 GOSUB 7100: REM DECODE RECORD FOR TR$(IX%)
3314 PRINT "  "+STR$(IX%)+". "+NA$+", "+VN$: IX%=IX%+1: GOTO 3312
3315 PRINT ""
3316 GOSUB 1010
3317 TP%=INT((TC%+PG%-1)/PG%): REM TOTAL PAGES
3318 PRINT "  PAGE "+STR$(PX%)+" OF "+STR$(TP%)
3319 PRINT ""
3320 IF PX%<TP% THEN PRINT "  W=NEXT  ";
3321 IF PX%>1 THEN PRINT "  Z=BACK  ";
3322 PRINT "  M=MENU"
3323 PRINT "  1-"+STR$(TC%)+"=SELECT"
3324 PRINT ""
3325 PRINT "  KEY: ";
3326 GOSUB 1020
3327 IF K$="M" OR K$="m" THEN SC%=1: GOTO 3000
3328 IF (K$="W" OR K$="w") AND PX%<TP% THEN PX%=PX%+1: GOTO 3300
3329 IF (K$="Z" OR K$="z") AND PX%>1 THEN PX%=PX%-1: GOTO 3300
3330 REM --- SELECT DIGIT 1-8 ---
3331 SL%=VAL(K$)
3332 IF SL%<1 OR SL%>TC% THEN GOTO 3325
3333 CU%=TR%(SL%): REM INDEX IN RC$
3334 PS%=SC%: MD%=1: GOSUB 7000: GOTO 5100: REM DETAIL VIEW

3700 REM *** MESSAGE SCREEN ***
3701 GOSUB 1000
3702 PRINT ""
3703 PRINT "  "+MG$
3704 PRINT ""
3705 GOSUB 1010
3706 PRINT "  PRESS ANY KEY..."
3707 GOSUB 1020
3708 IF MR%=1 THEN SC%=1: GOTO 3000: REM -> MAIN MENU
3709 IF MR%=2 THEN SC%=2: GOTO 3000: REM -> SEARCH MASK
3710 IF MR%=3 THEN SC%=3: GOTO 3000: REM -> RESULTS LIST
3711 SC%=1: GOTO 3000

3900 REM *** QUIT ***
3901 GOSUB 1000
3902 PRINT ""
3903 PRINT "  GOODBYE!"
3904 PRINT ""
3905 END

4000 REM *** ENTRY FORM (NEW/EDIT ENTRY) ***
4001 GOSUB 1000
4002 IF MD%=0 THEN PRINT "  NEW ENTRY"
4003 IF MD%=1 THEN PRINT "  EDIT ENTRY"
4004 IF MD%=2 THEN PRINT "  COPY ENTRY"
4005 PRINT ""
4006 GOSUB 1010
4007 PRINT ""
4008 REM --- LAST NAME ---
4009 PRINT "  LAST NAME   (max. 30): ";
4010 IN$=F$(1): EM%=NL%: GOSUB 1030: F$(1)=IN$: PRINT ""
4011 REM --- FIRST NAME ---
4012 PRINT "  FIRST NAME  (max. 30): ";
4013 IN$=F$(2): EM%=VL%: GOSUB 1030: F$(2)=IN$: PRINT ""
4014 REM --- EMAIL ---
4015 PRINT "  EMAIL       (max. 40): ";
4016 IN$=F$(3): EM%=EL%: GOSUB 1030: F$(3)=IN$: PRINT ""
4017 REM --- STREET ---
4018 PRINT "  STREET      (max. 40): ";
4019 IN$=F$(4): EM%=SL%: GOSUB 1030: F$(4)=IN$: PRINT ""
4020 REM --- CITY ---
4021 PRINT "  CITY        (max. 30): ";
4022 IN$=F$(5): EM%=OL%: GOSUB 1030: F$(5)=IN$: PRINT ""
4023 REM --- PHONE ---
4024 PRINT "  PHONE       (max. 20): ";
4025 IN$=F$(6): EM%=TL%: GOSUB 1030: F$(6)=IN$: PRINT ""
4026 PRINT ""
4027 GOSUB 1010
4028 PRINT "  S=SAVE  A=CANCEL"
4029 PRINT ""
4030 PRINT "  KEY: ";
4031 GOSUB 1020
4032 IF K$="A" OR K$="a" THEN GOTO 4200: REM CANCEL
4033 IF K$="S" OR K$="s" THEN GOTO 4100: REM SAVE
4034 GOTO 4030

4100 REM *** REQUIRED FIELD CHECK AND SAVE ***
4101 REM PIPE SANITIZATION ---
4102 FI%=1: GOSUB 7200
4103 FI%=2: GOSUB 7200
4104 FI%=3: GOSUB 7200
4105 FI%=4: GOSUB 7200
4106 FI%=5: GOSUB 7200
4107 FI%=6: GOSUB 7200
4108 REM REQUIRED FIELDS ---
4109 IF F$(1)="" THEN PRINT "  ERROR: LAST NAME IS REQUIRED!": PRINT "": GOTO 4028
4110 IF F$(2)="" THEN PRINT "  ERROR: FIRST NAME IS REQUIRED!": PRINT "": GOTO 4028
4111 NW$=F$(1)+"|"+F$(2)+"|"+F$(3)+"|"+F$(4)+"|"+F$(5)+"|"+F$(6)
4112 IF MD%=1 THEN RC$(CU%)=NW$: GOTO 4120: REM EDIT
4113 IF RC%>=MX% THEN PRINT "  ERROR: STORAGE FULL!": PRINT "": GOTO 4028
4114 RC%=RC%+1: RC$(RC%)=NW$
4120 GOSUB 2100
4121 MG$="SAVED!": MR%=1: SC%=7: GOTO 3000

4200 REM *** CANCEL ***
4201 IF MD%=0 THEN SC%=2: GOTO 3000: REM NEW ENTRY -> SEARCH MASK
4202 SC%=3: GOTO 3000: REM EDIT/COPY -> RESULTS LIST

5000 REM *** SEARCH BY LAST NAME ***
5001 TC%=0
5002 SI%=1
5003 IF SI%>RC% THEN GOTO 5007
5004 GOSUB 7300: REM READ LAST NAME FROM RC$(SI%)
5005 IF XN$=SN$ THEN TC%=TC%+1: TR%(TC%)=SI%
5006 SI%=SI%+1: GOTO 5003
5007 RETURN

5100 REM *** DETAIL VIEW OF AN ENTRY ***
5101 GOSUB 1000
5102 PRINT "  ENTRY DETAILS"
5103 PRINT ""
5104 GOSUB 1010
5105 PRINT "  LAST NAME : "+F$(1)
5106 PRINT "  FIRST NAME: "+F$(2)
5107 PRINT "  EMAIL     : "+F$(3)
5108 PRINT "  STREET    : "+F$(4)
5109 PRINT "  CITY      : "+F$(5)
5110 PRINT "  PHONE     : "+F$(6)
5111 PRINT ""
5112 GOSUB 1010
5113 PRINT "  B=EDIT  K=COPY  L=DELETE  A=BACK"
5114 PRINT ""
5115 PRINT "  KEY: ";
5116 GOSUB 1020
5117 IF K$="B" OR K$="b" THEN SC%=4: MD%=1: GOTO 3000: REM EDIT
5118 IF K$="K" OR K$="k" THEN SC%=4: MD%=2: GOSUB 7400: GOTO 3000: REM COPY
5119 IF K$="L" OR K$="l" THEN SC%=6: GOTO 3000: REM DELETE
5120 IF K$="A" OR K$="a" THEN SC%=3: GOTO 3000: REM BACK TO RESULTS LIST
5121 GOTO 5115

5600 REM *** DELETE CONFIRMATION ***
5601 GOSUB 1000
5602 PRINT ""
5603 PRINT "  REALLY DELETE ENTRY?"
5604 PRINT ""
5605 PRINT "  "+F$(1)+", "+F$(2)
5606 IF F$(3)<>"" THEN PRINT "  "+F$(3)
5607 PRINT ""
5608 GOSUB 1010
5609 PRINT "  Y=YES (DELETE)  N=NO (BACK)"
5610 PRINT ""
5611 PRINT "  KEY: ";
5612 GOSUB 1020
5613 IF K$="N" OR K$="n" THEN SC%=3: GOTO 3000: REM CANCEL -> RESULTS LIST
5614 IF K$="Y" OR K$="y" THEN GOTO 5700: REM DELETE
5615 GOTO 5611

5700 REM *** DELETE ENTRY ***
5701 DI%=CU%
5702 IF DI%>RC%-1 THEN GOTO 5704
5703 RC$(DI%)=RC$(DI%+1): DI%=DI%+1: GOTO 5702
5704 RC$(RC%)=""
5705 RC%=RC%-1
5706 GOSUB 2100: REM WRITE
5707 MG$="ENTRY DELETED!": MR%=1: SC%=7: GOTO 3000

6000 REM *** SHOW ALL ADDRESSES ***
6001 GOSUB 2000: GOSUB 1000
6002 PRINT "  ALL ADDRESSES"
6003 PRINT ""
6004 IF RC%=0 THEN GOTO 6040
6005 GOSUB 1010
6006 REM --- CALCULATE PAGE ---
6007 PF%=(PX%-1)*PG%+1
6008 PL%=PF%+PG%-1
6009 IF PL%>RC% THEN PL%=RC%
6010 LI%=PF%
6011 IF LI%>PL% THEN GOTO 6018
6012 GOSUB 7500: REM FELDER AUS RC$(LI%) LESEN (LI% BEREITS GESETZT)
6013 PRINT "  "+STR$(LI%)+". "+NA$+", "+VN$
6014 IF EM$<>"" THEN PRINT "     "+EM$
6015 IF ST$<>"" THEN PRINT "     "+ST$+", "+OT$
6016 IF TF$<>"" THEN PRINT "     TEL: "+TF$
6017 PRINT "": LI%=LI%+1: GOTO 6011
6018 GOSUB 1010
6019 TP%=INT((RC%+PG%-1)/PG%): REM TOTAL PAGES
6020 PRINT "  PAGE "+STR$(PX%)+" OF "+STR$(TP%)
6021 PRINT ""
6022 IF PX%<TP% THEN PRINT "  W=NEXT  ";
6023 IF PX%>1 THEN PRINT "  Z=BACK  ";
6024 PRINT "  M=MENU"
6025 PRINT ""
6026 PRINT "  KEY: ";
6027 GOSUB 1020
6028 IF K$="M" OR K$="m" THEN SC%=1: GOTO 3000
6029 IF (K$="W" OR K$="w") AND PX%<TP% THEN PX%=PX%+1: GOTO 6000
6030 IF (K$="Z" OR K$="z") AND PX%>1 THEN PX%=PX%-1: GOTO 6000
6031 GOTO 6026
6040 PRINT "  NO ADDRESSES FOUND."
6041 PRINT ""
6042 GOSUB 1010
6043 PRINT "  PRESS ANY KEY..."
6044 GOSUB 1020
6045 SC%=1
6046 GOTO 3000

7000 REM *** FILL FORM WITH CURRENT FIELDS ***
7001 REM MD%=0: EMPTY, MD%=1 OR 2: FROM CU% ***
7002 F$(1)="": F$(2)="": F$(3)="": F$(4)="": F$(5)="": F$(6)=""
7003 IF MD%=0 THEN RETURN: REM NEW ENTRY: LEAVE FIELDS EMPTY
7004 REM LOAD FIELDS FROM CURRENT RECORD ---
7005 LI%=CU%: GOSUB 7500: REM RC$(CU%) DEKODIEREN -> FELDER SETZEN
7006 F$(1)=NA$: F$(2)=VN$: F$(3)=EM$: F$(4)=ST$: F$(5)=OT$: F$(6)=TF$
7007 RETURN

7100 REM *** READ LAST+FIRST NAME FROM TR$(IX%) ***
7101 REM READS TR$(IX%) INDIRECTLY FROM RC$ ---
7102 RI%=TR%(IX%): REM INDEX IN RC$
7103 RS$=RC$(RI%)
7104 GOSUB 7600
7105 IF PP%=0 THEN NA$=RS$: VN$="": RETURN
7106 NA$=LEFT$(RS$,PP%-1)
7107 RS$=MID$(RS$,PP%+1)
7108 GOSUB 7600
7109 IF PP%=0 THEN VN$=RS$: RETURN
7110 VN$=LEFT$(RS$,PP%-1)
7111 RETURN

7200 REM *** REMOVE PIPE CHARS FROM FIELD FI% ***
7201 TP$="": TS$=F$(FI%): LF%=LEN(TS$): TI%=1
7202 IF TI%>LF% THEN GOTO 7206
7203 TC$=MID$(TS$,TI%,1)
7204 IF TC$<>"|" AND TC$<>CHR$(13) AND TC$<>CHR$(10) THEN TP$=TP$+TC$
7205 TI%=TI%+1: GOTO 7202
7206 F$(FI%)=TP$
7207 RETURN

7300 REM *** READ LAST NAME FROM RC$(SI%) -> XN$ ***
7301 RS$=RC$(SI%)
7302 GOSUB 7600
7303 IF PP%=0 THEN XN$=RS$: RETURN
7304 XN$=LEFT$(RS$,PP%-1)
7305 RETURN

7400 REM *** COPY PREP: LOAD FIELDS FROM CU% ***
7401 GOSUB 7500: REM DECODE
7402 F$(1)=NA$: F$(2)=VN$: F$(3)=EM$: F$(4)=ST$: F$(5)=OT$: F$(6)=TF$
7403 RETURN

7500 REM *** DECODE ALL FIELDS FROM RC$(LI%) ***
7501 REM ERGEBNIS: NA$,VN$,EM$,ST$,OT$,TF$ ***
7502 IF LI%=0 THEN LI%=CU%: REM FALLBACK TO CURRENT
7503 RS$=RC$(LI%)
7504 REM --- LAST NAME ---
7505 GOSUB 7600
7506 IF PP%=0 THEN NA$=RS$: VN$="": EM$="": ST$="": OT$="": TF$="": RETURN
7507 NA$=LEFT$(RS$,PP%-1): RS$=MID$(RS$,PP%+1)
7508 REM --- FIRST NAME ---
7509 GOSUB 7600
7510 IF PP%=0 THEN VN$=RS$: EM$="": ST$="": OT$="": TF$="": RETURN
7511 VN$=LEFT$(RS$,PP%-1): RS$=MID$(RS$,PP%+1)
7512 REM --- EMAIL ---
7513 GOSUB 7600
7514 IF PP%=0 THEN EM$=RS$: ST$="": OT$="": TF$="": RETURN
7515 EM$=LEFT$(RS$,PP%-1): RS$=MID$(RS$,PP%+1)
7516 REM --- STREET ---
7517 GOSUB 7600
7518 IF PP%=0 THEN ST$=RS$: OT$="": TF$="": RETURN
7519 ST$=LEFT$(RS$,PP%-1): RS$=MID$(RS$,PP%+1)
7520 REM --- CITY ---
7521 GOSUB 7600
7522 IF PP%=0 THEN OT$=RS$: TF$="": RETURN
7523 OT$=LEFT$(RS$,PP%-1): RS$=MID$(RS$,PP%+1)
7524 REM --- PHONE ---
7525 TF$=RS$
7526 RETURN

7600 REM *** FIND POSITION OF "|" IN RS$ -> PP% ***
7601 PP%=0
7602 LP%=LEN(RS$)
7603 IF LP%=0 THEN RETURN
7604 IX%=1
7605 IF IX%>LP% THEN RETURN
7606 IF MID$(RS$,IX%,1)="|" THEN PP%=IX%: RETURN
7607 IX%=IX%+1: GOTO 7605
7608 RETURN

9000 REM *** GLOBAL ERROR HANDLER ***
9001 EV%=ERR: REM SAVE ERROR CODE
9002 GOSUB 1000
9003 PRINT ""
9004 PRINT "  *** ERROR NO. "+STR$(EV%)+" ***"
9005 PRINT ""
9006 PRINT "  DISK ERROR OR MEMORY PROBLEM."
9007 PRINT "  DATA WAS NOT CHANGED."
9008 PRINT ""
9009 GOSUB 1010
9010 PRINT "  PRESS ANY KEY - BACK..."
9011 GOSUB 1020
9012 REM --- BACK TO PREVIOUS SCREEN ---
9013 SC%=PS%
9014 IF SC%<1 OR SC%>7 THEN SC%=1
9015 GOTO 3000

